<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.sdubooks.controller.AdminController"
            prefWidth="1200" prefHeight="800"
            style="-fx-background-color: #f0f2f5;">

    <!-- 顶部栏 -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15"
              style="-fx-background-color: white; -fx-padding: 16 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 2, 0);">
            <children>
                <Label text="📚" style="-fx-font-size: 24px;"/>
                <Label text="图书管理系统" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                <Label text="管理后台" style="-fx-font-size: 14px; -fx-text-fill: #94a3b8; -fx-padding: 4 0 0 0;"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button fx:id="logoutBtn" text="退出登录" onAction="#handleLogout"
                        style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand;"/>
            </children>
        </HBox>
    </top>

    <!-- 左侧导航栏 -->
    <left>
        <VBox fx:id="leftNav" spacing="4"
              style="-fx-background-color: white; -fx-padding: 20 12; -fx-min-width: 200; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 1, 0);">
            <children>
                <Label text="导航菜单" style="-fx-font-size: 12px; -fx-text-fill: #94a3b8; -fx-padding: 0 8 12 8;"/>

                <Button fx:id="dashboardBtn" text="📊  仪表板" onAction="#switchToDashboard"
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 12 16; -fx-background-color: #ede9fe; -fx-text-fill: #5a3cff; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 10; -fx-cursor: hand;"
                        maxWidth="Infinity"/>

                <Button fx:id="bookBtn" text="📖  书籍管理" onAction="#switchToBookManagement"
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 12 16; -fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 14px; -fx-background-radius: 10; -fx-cursor: hand;"
                        maxWidth="Infinity"/>

                <Button fx:id="userBtn" text="👥  用户管理" onAction="#switchToUserManagement"
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 12 16; -fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 14px; -fx-background-radius: 10; -fx-cursor: hand;"
                        maxWidth="Infinity"/>

                <Button fx:id="statBtn" text="📈  借阅统计" onAction="#switchToBorrowStatistics"
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 12 16; -fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 14px; -fx-background-radius: 10; -fx-cursor: hand;"
                        maxWidth="Infinity"/>

                <Button fx:id="overdueBtn" text="⚠️  逾期管理" onAction="#switchToOverdueManagement"
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 12 16; -fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 14px; -fx-background-radius: 10; -fx-cursor: hand;"
                        maxWidth="Infinity"/>
            </children>
        </VBox>
    </left>

    <!-- 主内容区（动态加载区域）-->
    <center>
        <AnchorPane fx:id="contentPane" style="-fx-background-color: #f0f2f5;">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
        </AnchorPane>
    </center>

</BorderPane>
