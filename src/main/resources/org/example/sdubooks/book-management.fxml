<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.sdubooks.controller.BookManagementController"
            fitToWidth="true"
            style="-fx-background-color: #f0f2f5;">

    <VBox spacing="20" style="-fx-padding: 24; -fx-background-color: #f0f2f5;">

        <!-- 页面标题 + 新增按钮 -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="书籍管理" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                <Label text="管理馆藏图书信息" style="-fx-font-size: 14px; -fx-text-fill: #94a3b8;"/>
            </VBox>
            <Button text="+ 新增书籍" onAction="#handleAddBook"
                    style="-fx-background-color: #5a3cff; -fx-text-fill: white; -fx-padding: 10 24; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </HBox>

        <!-- 搜索栏 -->
        <HBox spacing="12" alignment="CENTER_LEFT"
              style="-fx-padding: 16; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 1, 0);">
            <TextField fx:id="searchField" promptText="🔍 按书名或作者搜索..." prefWidth="300"
                       style="-fx-background-radius: 8;"/>
            <Button text="搜索" onAction="#handleSearch"
                    style="-fx-background-color: #5a3cff; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label text="共 " style="-fx-text-fill: #64748b;"/>
            <Label fx:id="totalBooksLabel" text="0" style="-fx-font-weight: bold; -fx-text-fill: #5a3cff;"/>
            <Label text=" 本书" style="-fx-text-fill: #64748b;"/>
        </HBox>

        <!-- 书籍表格 -->
        <TableView fx:id="booksTable" prefHeight="500"
                   style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 1, 0);">
            <columns>
                <TableColumn text="书名" prefWidth="200">
                    <cellValueFactory><PropertyValueFactory property="title"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="作者" prefWidth="150">
                    <cellValueFactory><PropertyValueFactory property="author"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="总库存" prefWidth="100">
                    <cellValueFactory><PropertyValueFactory property="total"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="可借数量" prefWidth="100">
                    <cellValueFactory><PropertyValueFactory property="available"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="操作" prefWidth="180"/>
            </columns>
        </TableView>

        <!-- 底部分页 -->
        <HBox spacing="12" alignment="CENTER_RIGHT"
              style="-fx-padding: 12 16; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 1, 0);">
            <Button fx:id="prevPageBtn" text="❮ 上一页" onAction="#handlePreviousPage"
                    style="-fx-background-color: #e2e8f0; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Label fx:id="pageInfoLabel" text="1/1" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-padding: 0 8;"/>
            <Button fx:id="nextPageBtn" text="下一页 ❯" onAction="#handleNextPage"
                    style="-fx-background-color: #e2e8f0; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </HBox>

    </VBox>
</ScrollPane>
