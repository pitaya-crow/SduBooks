<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.sdubooks.controller.SelfController"
            prefHeight="800.0" prefWidth="600.0"
            style="-fx-background-color: #f8fafc;">
    <top>
        <fx:include source="base.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <content>
                <VBox spacing="20.0" style="-fx-padding: 20;">
                    <!-- 用户信息卡片 -->
                    <HBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                        <!-- 头像 -->
                        <VBox alignment="CENTER" style="-fx-min-width: 100px;">
                            <Label text="👤" style="-fx-font-size: 60px;"/>
                        </VBox>

                        <!-- 用户信息 -->
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <Label fx:id="usernameLabel" text="张明" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                            <Label fx:id="emailLabel" text="zhangming@example.com" style="-fx-font-size: 16px; -fx-text-fill: #64748b;"/>
                            <HBox spacing="10.0" alignment="CENTER_LEFT">
                                <Label text="📅" style="-fx-font-size: 16px;"/>
                                <Label fx:id="joinDateLabel" text="加入时间：2023/5/15" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                            </HBox>
                        </VBox>

                        <!-- 统计数据 -->
                        <HBox spacing="30.0" alignment="CENTER_RIGHT">
                            <VBox alignment="CENTER">
                                <Label fx:id="totalBorrowsLabel" text="12" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
                                <Label text="累计借阅" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                            </VBox>
                            <VBox alignment="CENTER">
                                <Label fx:id="currentBorrowsLabel" text="2" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #f97316;"/>
                                <Label text="在借图书" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                            </VBox>
                        </HBox>
                    </HBox>

                    <!-- 切换按钮 -->
                    <HBox spacing="10.0" alignment="CENTER" style="-fx-background-color: #f1f5f9; -fx-background-radius: 30; -fx-padding: 5;">
                        <Button fx:id="btnBorrowRecords" text="📖 借阅记录" onAction="#handleSwitchTab"
                                style="-fx-background-color: #ffffff; -fx-background-radius: 25; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-padding: 10 30; -fx-cursor: hand;"
                                userData="borrows"/>
                        <Button fx:id="btnReviews" text="👤 我的书评" onAction="#handleSwitchTab"
                                style="-fx-background-color: transparent; -fx-font-size: 16px; -fx-text-fill: #64748b; -fx-padding: 10 30; -fx-cursor: hand;"
                                userData="reviews"/>
                    </HBox>

                    <!-- 内容区域 -->
                    <VBox fx:id="contentArea" spacing="15.0"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
