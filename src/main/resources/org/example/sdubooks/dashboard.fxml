<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.sdubooks.controller.DashboardController"
            fitToWidth="true"
            style="-fx-background-color: #f0f2f5;">

    <VBox spacing="24" style="-fx-padding: 24; -fx-background-color: #f0f2f5;">

        <!-- 页面标题 -->
        <VBox spacing="4">
            <Label text="仪表板" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <Label text="系统运行概览" style="-fx-font-size: 14px; -fx-text-fill: #94a3b8;"/>
        </VBox>

        <!-- 统计卡片 -->
        <HBox spacing="16">
            <!-- 馆藏图书 -->
            <VBox spacing="8" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                  style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 1, 0);">
                <Label text="📚 馆藏图书" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                <Label fx:id="totalBooksLabel" text="0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                <Label text="总藏书量" style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"/>
            </VBox>

            <!-- 借出图书 -->
            <VBox spacing="8" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                  style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 1, 0);">
                <Label text="📤 借出图书" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                <Label fx:id="borrowedBooksLabel" text="0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
                <Label text="当前借出中" style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"/>
            </VBox>

            <!-- 注册用户 -->
            <VBox spacing="8" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                  style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 1, 0);">
                <Label text="👥 注册用户" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                <Label fx:id="registeredUsersLabel" text="0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #22c55e;"/>
                <Label text="系统注册用户" style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"/>
            </VBox>

            <!-- 逾期图书 -->
            <VBox spacing="8" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                  style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 1, 0);">
                <Label text="⚠️ 逾期图书" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                <Label fx:id="overdueBooksLabel" text="0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #ef4444;"/>
                <Label text="需要处理" style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"/>
            </VBox>
        </HBox>

        <!-- 最近活动 -->
        <VBox spacing="12" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 1, 0);">
            <Label text="📋 最近活动" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <Separator/>
            <VBox fx:id="recentActivitiesBox" spacing="8"/>
        </VBox>

        <!-- 热门图书 & 活跃用户 -->
        <HBox spacing="16">
            <!-- 热门图书 -->
            <VBox spacing="12" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                  style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 1, 0);">
                <Label text="🔥 热门图书" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                <Separator/>
                <VBox fx:id="hotBooksBox" spacing="10"/>
            </VBox>

            <!-- 活跃用户 -->
            <VBox spacing="12" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                  style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 1, 0);">
                <Label text="⭐ 活跃用户" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                <Separator/>
                <VBox fx:id="activeUsersBox" spacing="10"/>
            </VBox>
        </HBox>

    </VBox>
</ScrollPane>
