<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.sdubooks.controller.AdminController"
            prefWidth="1200" prefHeight="800">

    <!-- 顶部栏 -->
    <top>
        <HBox style="-fx-background-color: #ffffff; -fx-padding: 12px; -fx-border-bottom: 1px solid #e0e0e0;">
            <children>
                <Label text="📱 管理员后台" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333;">
                </Label>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button fx:id="logoutBtn" text="→ 退出登录" onAction="#handleLogout"
                        style="-fx-background-color: transparent; -fx-text-fill: #666; -fx-cursor: hand;"/>
            </children>
        </HBox>
    </top>

    <!-- 左侧导航栏 -->
    <left>
        <VBox style="-fx-background-color: #f8f9fa; -fx-padding: 20px 0;" spacing="8">
            <children>
                <Button fx:id="dashboardBtn" text="仪表板" graphicTextGap="12" onAction="#switchToDashboard"
                        style="-fx-alignment: LEFT; -fx-padding: 14px 20px; -fx-background-color: #f0f0ff; -fx-text-fill: #5a3cff; -fx-font-weight: bold;"/>
                <Button fx:id="bookBtn" text="书籍管理" graphicTextGap="12" onAction="#switchToBookManagement"
                        style="-fx-alignment: LEFT; -fx-padding: 14px 20px; -fx-background-color: transparent; -fx-text-fill: #333;"/>
                <Button fx:id="userBtn" text="用户管理" graphicTextGap="12" onAction="#switchToUserManagement"
                        style="-fx-alignment: LEFT; -fx-padding: 14px 20px; -fx-background-color: transparent; -fx-text-fill: #333;"/>
                <Button fx:id="statBtn" text="借阅统计" graphicTextGap="12" onAction="#switchToBorrowStatistics"
                        style="-fx-alignment: LEFT; -fx-padding: 14px 20px; -fx-background-color: transparent; -fx-text-fill: #333;"/>
            </children>
        </VBox>
    </left>

    <!-- 主内容区（动态加载区域）-->
    <center>
        <AnchorPane fx:id="contentPane" />
    </center>

</BorderPane>