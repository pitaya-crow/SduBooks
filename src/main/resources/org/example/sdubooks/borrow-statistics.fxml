<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.sdubooks.controller.BorrowStatisticsController"
            fitToWidth="true"
            style="-fx-background-color: #f0f2f5;">

    <VBox spacing="20" style="-fx-padding: 24; -fx-background-color: #f0f2f5;">

        <!-- 页面标题 -->
        <VBox spacing="4">
            <Label text="借阅统计" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <Label text="查看图书借阅数据和趋势" style="-fx-font-size: 14px; -fx-text-fill: #94a3b8;"/>
        </VBox>

        <!-- 统计卡片 -->
        <HBox spacing="16">
            <!-- 总借阅次数 -->
            <VBox spacing="8" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                  style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 1, 0);">
                <Label text="📤 总借阅次数" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                <Label fx:id="totalBorrowLabel" text="0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
                <Label text="最近6个月" style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"/>
            </VBox>

            <!-- 总归还次数 -->
            <VBox spacing="8" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                  style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 1, 0);">
                <Label text="📥 总归还次数" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                <Label fx:id="totalReturnLabel" text="0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #22c55e;"/>
                <Label text="最近6个月" style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"/>
            </VBox>

            <!-- 本月增长率 -->
            <VBox spacing="8" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                  style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 1, 0);">
                <Label text="📈 本月增长率" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                <Label fx:id="growthRateLabel" text="0%" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #22c55e;"/>
                <Label text="相比上月" style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"/>
            </VBox>
        </HBox>

        <!-- 借阅趋势图 -->
        <VBox spacing="12" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 1, 0);">
            <Label text="📊 借阅趋势" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <Separator/>
            <VBox fx:id="trendChartBox" spacing="10"/>
        </VBox>

        <!-- 分类统计图 -->
        <VBox spacing="12" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 1, 0);">
            <Label text="📚 分类统计" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <Separator/>
            <VBox fx:id="categoryChartBox" spacing="10"/>
        </VBox>

        <!-- 借阅排行 -->
        <VBox spacing="12" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 1, 0);">
            <Label text="🏆 借阅排行" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <Separator/>
            <VBox fx:id="borrowRankBox" spacing="10"/>
        </VBox>

    </VBox>
</ScrollPane>
