<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.geometry.Insets?>
        <?import javafx.scene.control.*?>
        <?import javafx.scene.layout.*?>
        <?import javafx.scene.text.*?>
        <?import javafx.scene.shape.Rectangle?>
        <?import javafx.scene.control.ScrollPane?>
        <?import javafx.scene.image.ImageView?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.sdubooks.controller.HomePageController"
            style="-fx-background-color: #f8fafc;">

    <!-- 顶部导航栏 -->
    <top>
        <fx:include source="base.fxml"/>
    </top>

    <!-- 主内容区域 -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f8fafc;">
            <VBox spacing="40.0" style="-fx-padding: 30;">

                <StackPane style="-fx-background-color: linear-gradient(to right, #3b82f6, #a855f7); -fx-background-radius: 25;"
                           maxHeight="300" minHeight="300">
                    <HBox alignment="CENTER_LEFT" spacing="40.0" style="-fx-padding: 40;">
                        <VBox spacing="20.0">
                            <Label text="欢迎来到图书管理系统"
                                   style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label text="发现、借阅、分享你喜爱的书籍"
                                   style="-fx-font-size: 20px; -fx-text-fill: rgba(255,255,255,0.9);"/>

                            <!-- 统计数据 -->
                            <HBox spacing="25.0" style="-fx-padding: 20 0 0 0;">
                                <VBox alignment="CENTER" spacing="8.0"
                                      style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 15; -fx-padding: 20 30;">
                                    <Label fx:id="bookCountLabel" text="8" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                    <Label text="馆藏图书" style="-fx-font-size: 16px; -fx-text-fill: rgba(255,255,255,0.9);"/>
                                </VBox>
                                <VBox alignment="CENTER" spacing="8.0"
                                      style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 15; -fx-padding: 20 30;">
                                    <Label fx:id="borrowCountLabel" text="1,248" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                    <Label text="借阅次数" style="-fx-font-size: 16px; -fx-text-fill: rgba(255,255,255,0.9);"/>
                                </VBox>
                                <VBox alignment="CENTER" spacing="8.0"
                                      style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 15; -fx-padding: 20 30;">
                                    <Label fx:id="userCountLabel" text="356" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                    <Label text="注册用户" style="-fx-font-size: 16px; -fx-text-fill: rgba(255,255,255,0.9);"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </HBox>
                </StackPane>

                <!-- 图书分类区域 -->
                <VBox spacing="20.0">
                    <Label text="图书分类" styleClass="section-title"/>
                    <GridPane fx:id="categoryGrid" hgap="20.0" vgap="20.0">
                        <columnConstraints>
                            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS"/>
                            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS"/>
                            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS"/>
                            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS"/>
                        </columnConstraints>
                    </GridPane>
                </VBox>

                <!-- 最热书籍区域 -->
                <VBox spacing="20.0">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="📈 最热书籍" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="查看排行榜 →" onAction="#handleViewRankings"
                                style="-fx-background-color: transparent; -fx-text-fill: #3b82f6; -fx-font-size: 18px; -fx-font-weight: 500;"/>
                    </HBox>

                    <GridPane hgap="25.0" vgap="25.0">
                        <columnConstraints>
                            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS"/>
                            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS"/>
                        </columnConstraints>

                        <!-- 书籍卡片1: 百年孤独 -->
                        <HBox spacing="0"
                              style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5); -fx-padding: 0; -fx-cursor: hand;"
                              onMouseClicked="#handleBookCardClick" userData="百年孤独"
                              GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <StackPane style="-fx-background-color: #d4a574; -fx-pref-width: 150; -fx-min-width: 150; -fx-max-width: 150; -fx-pref-height: 200; -fx-min-height: 200; -fx-max-height: 200;">
                                <ImageView fitWidth="150" fitHeight="200" preserveRatio="true"/>
                            </StackPane>

                            <VBox spacing="10.0" style="-fx-padding: 20; -fx-pref-width: 350;" HBox.hgrow="ALWAYS">
                                <Label text="百年孤独" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                                <Label text="加西亚·马尔克斯" style="-fx-font-size: 16px; -fx-text-fill: #475569;"/>
                                <HBox alignment="CENTER_LEFT" spacing="5.0">
                                    <Label text="⭐" style="-fx-font-size: 18px;"/>
                                    <Label text="4.9" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f59e0b;"/>
                                </HBox>
                                <Label text="《百年孤独》是魔幻现实主义文学的代表作，描写了布恩迪亚家族七代人的传奇故事，以及加勒比..."
                                       style="-fx-font-size: 14px; -fx-text-fill: #64748b;" wrapText="true" maxWidth="320" maxHeight="60"/>

                                <HBox alignment="CENTER_LEFT">
                                    <Label text="fiction" style="-fx-background-color: #f1f5f9; -fx-text-fill: #1e293b; -fx-font-size: 14px; -fx-padding: 5 12; -fx-background-radius: 15;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="借阅 412 次" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                                </HBox>

                                <Label text="已借出" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #ef4444;"/>
                            </VBox>
                        </HBox>
                    </GridPane>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
