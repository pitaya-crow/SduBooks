<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.sdubooks.controller.AdminController"
            prefWidth="1400"
            prefHeight="900"
            style="-fx-background-color:#f5f5f5;">

    <!-- 顶部 -->
    <top>
        <HBox alignment="CENTER_LEFT"
              prefHeight="90"
              spacing="20"
              style="-fx-background-color:white;
                     -fx-border-color:#dddddd;
                     -fx-border-width:0 0 1 0;">

            <padding>
                <Insets top="20" right="30" bottom="20" left="30"/>
            </padding>

            <Label text="📱"
                   style="-fx-font-size:32px;
                          -fx-text-fill:#9333ea;"/>

            <Label text="管理员后台"
                   style="-fx-font-size:32px;
                          -fx-font-weight:bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="退出登录"
                    style="-fx-background-color:white;
                           -fx-font-size:18px;
                           -fx-cursor:hand;"/>
        </HBox>
    </top>

    <!-- 左侧菜单 -->
    <left>
        <VBox spacing="20"
              prefWidth="320"
              style="-fx-background-color:white;
                     -fx-background-radius:20;
                     -fx-border-radius:20;
                     -fx-border-color:#dddddd;">

            <padding>
                <Insets top="40" right="25" bottom="40" left="25"/>
            </padding>

            <Button fx:id="dashboardBtn"
                    text="仪表板"
                    prefWidth="260"
                    prefHeight="70"
                    onAction="#showDashboard"
                    style="-fx-background-color:#f3e8ff;
                           -fx-text-fill:#9333ea;
                           -fx-font-size:26px;
                           -fx-background-radius:20;
                           -fx-border-radius:20;
                           -fx-border-color:#d8b4fe;
                           -fx-border-width:2;
                           -fx-alignment:CENTER-LEFT;
                           -fx-padding:0 0 0 30;
                           -fx-cursor:hand;"/>

            <Button fx:id="bookBtn"
                    text="书籍管理"
                    prefWidth="260"
                    prefHeight="70"
                    onAction="#showBooks"
                    style="-fx-background-color:white;
                           -fx-font-size:26px;
                           -fx-background-radius:20;
                           -fx-border-radius:20;
                           -fx-alignment:CENTER-LEFT;
                           -fx-padding:0 0 0 30;
                           -fx-cursor:hand;"/>

            <Button fx:id="userBtn"
                    text="用户管理"
                    prefWidth="260"
                    prefHeight="70"
                    onAction="#showUsers"
                    style="-fx-background-color:white;
                           -fx-font-size:26px;
                           -fx-background-radius:20;
                           -fx-border-radius:20;
                           -fx-alignment:CENTER-LEFT;
                           -fx-padding:0 0 0 30;
                           -fx-cursor:hand;"/>

            <Button fx:id="borrowBtn"
                    text="借阅统计"
                    prefWidth="260"
                    prefHeight="70"
                    onAction="#showBorrow"
                    style="-fx-background-color:white;
                           -fx-font-size:26px;
                           -fx-background-radius:20;
                           -fx-border-radius:20;
                           -fx-alignment:CENTER-LEFT;
                           -fx-padding:0 0 0 30;
                           -fx-cursor:hand;"/>
        </VBox>
    </left>

    <!-- 右侧内容区 -->
    <center>
        <StackPane fx:id="contentPane"
                   style="-fx-padding:30;"/>
    </center>

</BorderPane>
