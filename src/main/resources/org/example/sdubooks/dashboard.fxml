<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.sdubooks.controller.DashboardController"
            prefWidth="900" prefHeight="700">

    <children>
        <Label text="仪表板" layoutX="20" layoutY="20" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

        <!-- 统计卡片网格 -->
        <GridPane layoutX="20" layoutY="60" hgap="20" vgap="20" prefWidth="860">
            <children>
                <!-- 馆藏图书 -->
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-padding: 16px; -fx-background-color: white; -fx-border-radius: 8px; -fx-border-color: #e0e0e0;">
                    <children>
                        <Label text="馆藏图书" style="-fx-font-size: 16px; -fx-text-fill: #666;"/>
                        <Label fx:id="totalBooksLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                        <Label text="总藏书 34 册" style="-fx-font-size: 12px; -fx-text-fill: #999;"/>
                    </children>
                </VBox>

                <!-- 借出图书 -->
                <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-padding: 16px; -fx-background-color: white; -fx-border-radius: 8px; -fx-border-color: #e0e0e0;">
                    <children>
                        <Label text="借出图书" style="-fx-font-size: 16px; -fx-text-fill: #666;"/>
                        <Label fx:id="borrowedBooksLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                        <Label text="可借 16 册" style="-fx-font-size: 12px; -fx-text-fill: #999;"/>
                    </children>
                </VBox>

                <!-- 注册用户 -->
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-padding: 16px; -fx-background-color: white; -fx-border-radius: 8px; -fx-border-color: #e0e0e0;">
                    <children>
                        <Label text="注册用户" style="-fx-font-size: 16px; -fx-text-fill: #666;"/>
                        <Label fx:id="registeredUsersLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                        <Label text="活跃用户 3" style="-fx-font-size: 12px; -fx-text-fill: #999;"/>
                    </children>
                </VBox>

                <!-- 逾期图书 -->
                <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-padding: 16px; -fx-background-color: white; -fx-border-radius: 8px; -fx-border-color: #e0e0e0;">
                    <children>
                        <Label text="逾期图书" style="-fx-font-size: 16px; -fx-text-fill: #666;"/>
                        <Label fx:id="overdueBooksLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                        <Label text="需要处理" style="-fx-font-size: 12px; -fx-text-fill: #999;"/>
                    </children>
                </VBox>
            </children>
        </GridPane>

        <!-- 最近活动 -->
        <Label text="最近活动" layoutX="20" layoutY="320" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <VBox fx:id="recentActivitiesBox" layoutX="20" layoutY="350" spacing="12" prefWidth="860"/>

        <!-- 热门图书 & 活跃用户 -->
        <HBox layoutX="20" layoutY="500" spacing="20" prefWidth="860">
            <children>
                <!-- 热门图书 -->
                <VBox prefWidth="420">
                    <children>
                        <Label text="热门图书" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>
                        <VBox fx:id="hotBooksBox" spacing="8" style="-fx-background-color: white; -fx-padding: 12px; -fx-border-radius: 8px; -fx-border-color: #e0e0e0;"/>
                    </children>
                </VBox>

                <!-- 活跃用户 -->
                <VBox prefWidth="420">
                    <children>
                        <Label text="活跃用户" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>
                        <VBox fx:id="activeUsersBox" spacing="8" style="-fx-background-color: white; -fx-padding: 12px; -fx-border-radius: 8px; -fx-border-color: #e0e0e0;"/>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane>