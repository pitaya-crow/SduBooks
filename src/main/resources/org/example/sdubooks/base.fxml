<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<fx:root type="javafx.scene.layout.HBox" xmlns:fx="http://javafx.com/fxml"
         fx:id="navigationBar"
         fx:controller="org.example.sdubooks.controller.BaseController"
         alignment="CENTER_LEFT" spacing="20.0"
         style="-fx-background-color: white; -fx-padding: 15 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">

    <!-- Logo -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Text text="📖" style="-fx-font-size: 28px;"/>
        <Label text="图书管理系统" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
    </HBox>

    <Region HBox.hgrow="ALWAYS"/>

    <!-- 导航按钮 -->
    <HBox alignment="CENTER" spacing="10.0">
        <Button text="首页" onAction="#handleHome"
                style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 16px; -fx-font-weight: 500;"/>
        <Button text="排行榜" onAction="#handleRankings"
                style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 16px; -fx-font-weight: 500;"/>
        <Button text="个人中心" onAction="#handleProfile"
                style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 16px; -fx-font-weight: 500;"/>
    </HBox>

    <Region HBox.hgrow="ALWAYS"/>

    <!-- 退出登录 -->
    <Button text="➡ 退出登录" onAction="#handleLogout"
            style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 16px; -fx-font-weight: 500;"/>
</fx:root>
