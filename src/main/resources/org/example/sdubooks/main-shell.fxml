<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.sdubooks.controller.MainShellController"
            style="-fx-background-color: #f0f2f5;">

    <!-- 顶部导航栏 -->
    <top>
        <HBox fx:id="navBar" alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: white; -fx-padding: 14 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 2, 0);">
            <Label text="📚 图书管理系统" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnHome" text="首页" onAction="#handleHome"
                    style="-fx-background-color: transparent; -fx-font-size: 15px; -fx-text-fill: #3b82f6; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Button fx:id="btnRankings" text="排行榜" onAction="#handleRankings"
                    style="-fx-background-color: transparent; -fx-font-size: 15px; -fx-text-fill: #64748b; -fx-cursor: hand;"/>
            <Button fx:id="btnProfile" text="个人中心" onAction="#handleProfile"
                    style="-fx-background-color: transparent; -fx-font-size: 15px; -fx-text-fill: #64748b; -fx-cursor: hand;"/>
            <Button text="退出登录" onAction="#handleLogout"
                    style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <!-- 内容区（动态加载子页面） -->
    <center>
        <StackPane fx:id="contentPane"/>
    </center>

</BorderPane>
