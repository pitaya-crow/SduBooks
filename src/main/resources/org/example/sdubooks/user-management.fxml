<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.sdubooks.controller.UserManagementController"
            fitToWidth="true"
            style="-fx-background-color: #f0f2f5;">

    <VBox spacing="20" style="-fx-padding: 24; -fx-background-color: #f0f2f5;">

        <!-- 页面标题 -->
        <VBox spacing="4">
            <Label text="用户管理" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <Label text="管理系统用户信息" style="-fx-font-size: 14px; -fx-text-fill: #94a3b8;"/>
        </VBox>

        <!-- 搜索栏 -->
        <HBox spacing="12" alignment="CENTER_LEFT"
              style="-fx-padding: 16; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 1, 0);">
            <TextField fx:id="searchField" promptText="🔍 按用户名或邮箱搜索..." prefWidth="300"
                       style="-fx-background-radius: 8;"/>
            <Button text="搜索" onAction="#handleSearch"
                    style="-fx-background-color: #5a3cff; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label text="共 " style="-fx-text-fill: #64748b;"/>
            <Label fx:id="totalUsersLabel" text="0" style="-fx-font-weight: bold; -fx-text-fill: #5a3cff;"/>
            <Label text=" 个用户" style="-fx-text-fill: #64748b;"/>
        </HBox>

        <!-- 用户表格 -->
        <TableView fx:id="usersTable" prefHeight="450"
                   style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 1, 0);">
            <columns>
                <TableColumn text="用户名" prefWidth="150">
                    <cellValueFactory><PropertyValueFactory property="username"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="邮箱" prefWidth="200">
                    <cellValueFactory><PropertyValueFactory property="email"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="角色" prefWidth="100">
                    <cellValueFactory><PropertyValueFactory property="role"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="状态" prefWidth="120">
                    <cellValueFactory><PropertyValueFactory property="enabled"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="操作" prefWidth="100"/>
            </columns>
        </TableView>

        <!-- 底部工具栏 -->
        <HBox spacing="12" alignment="CENTER_LEFT"
              style="-fx-padding: 12 16; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 1, 0);">
            <CheckBox fx:id="selectAllCheckbox" text="全选" onAction="#handleSelectAll"/>
            <Button text="批量删除" onAction="#handleBatchDelete"
                    style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <HBox spacing="8" alignment="CENTER_RIGHT">
                <Button fx:id="prevPageBtn" text="❮ 上一页" onAction="#handlePreviousPage"
                        style="-fx-background-color: #e2e8f0; -fx-background-radius: 8; -fx-cursor: hand;"/>
                <Label fx:id="pageInfoLabel" text="1/1" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-padding: 0 8;"/>
                <Button fx:id="nextPageBtn" text="下一页 ❯" onAction="#handleNextPage"
                        style="-fx-background-color: #e2e8f0; -fx-background-radius: 8; -fx-cursor: hand;"/>
            </HBox>
        </HBox>

    </VBox>
</ScrollPane>
